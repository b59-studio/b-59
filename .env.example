# Secrets are managed in Doppler (project `b59`), NOT in a local .env file.
# `pnpm dev` / `pnpm start` run through `doppler run`, which injects these at
# runtime. This file only documents the variable shape; to set real values:
#   doppler secrets set STRIPE_SECRET_KEY --project b59 --config dev_personal
# See doppler.yaml for the project/config binding.

# Stripe — donations
# Secret key from https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) in development and a live key (sk_live_...) in production.
# NEVER commit a real key. This file documents the shape only.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret for the /api/donate/webhook endpoint.
# Local: run `stripe listen --forward-to localhost:3000/api/donate/webhook`
#   and copy the whsec_... it prints.
# Production: create the endpoint in the Stripe dashboard (Developers > Webhooks)
#   and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL, used to build Stripe success/cancel redirect URLs.
# Already consumed elsewhere in the app; defaults to https://b-59.com if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry — error reporting (docs/adr/0001-telemetry-decision.md).
# Every variable is optional: with no DSN set the SDK is disabled and all
# captures are no-ops, so local development needs none of these.
# DSN from the Sentry project settings (Client Keys). The public twin is the
# same value inlined into the browser bundle — maintain it in Doppler as a
# secret reference (${SENTRY_DSN}), never as a hand-copied second value, and
# remember NEXT_PUBLIC_* changes take effect only on the next build.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}

# CI-only: source-map upload during `next build`. Without an auth token the
# build skips the upload and still succeeds.
SENTRY_ORG=b59-studio
SENTRY_PROJECT=b-59
SENTRY_AUTH_TOKEN=sntrys_xxx

# Plausible — superseded by Vercel Analytics on 2026-09-11
# (docs/adr/0002-pageview-analytics-on-vercel.md). Left wired but unset: it is
# the ready path back to a non-Vercel vendor. Setting it puts a SECOND
# analytics processor on every page, so update the privacy policy's processor
# list (messages/*.json, all five locales) in the same change. Build-inlined
# like all NEXT_PUBLIC_* values, so a change needs a redeploy, not just an
# environment update.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.b-59.com
